	b_dist(circulate(Genome2),circulate(Gen)) < b_dist(circulate(Genome1),circulate(Gen)).

action(Genome1,Genome2,Action,ActionCost) ?=>
	Action=tp151314,
	ActionCost = 1,
	final(Gen),
	safe(circulate(Genome1),circulate(Gen),16,14,15),
	Genome2 = normalize(transposition(Genome1,15,13,14)),
	b_dist(circulate(Genome2),circulate(Gen)) < b_dist(circulate(Genome1),circulate(Gen)).
